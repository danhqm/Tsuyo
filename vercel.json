{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "installCommand": "npm ci",
  "outputDirectory": "dist",
  "functions": {
    "api/page.mjs": {
      "includeFiles": "dist-server/**",
      "maxDuration": 30
    },
    "api/mcp.mjs": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/page?route=/"
    },
    {
      "source": "/.well-known/mcp",
      "destination": "/mcp.json"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/mcp",
      "destination": "/api/mcp"
    },
    {
      "source": "/api",
      "destination": "/api/public?route=api"
    },
    {
      "source": "/api/",
      "destination": "/api/public?route=api/"
    },
    {
      "source": "/api/products",
      "destination": "/api/public?route=api/products"
    },
    {
      "source": "/api/store",
      "destination": "/api/public?route=api/store"
    },
    {
      "source": "/api/pages",
      "destination": "/api/public?route=api/pages"
    },
    {
      "source": "/api/products/:id",
      "destination": "/api/public?route=api/products/:id"
    },
    {
      "source": "/api/:missing*",
      "destination": "/api/public?route=api/not-found"
    },
    {
      "source": "/:page*",
      "destination": "/api/page?route=:page*"
    }
  ]
}
